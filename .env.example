# Token for the OJP 2.0 API (https://api-manager.opentransportdata.swiss).
# Leave empty to use transport.opendata.ch only.
OJP_API_KEY=
# Token for the separate "OJP Fare" product (real NOVA ticket prices). Optional.
OJP_FARE_API_KEY=
# Web push for commute alerts. Generate a key pair once:
#   node --input-type=module -e 'import {generateVAPIDKeys as g} from "web-push"; console.log(g())'
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact for the push services (a mailto: or https: URL you control).
VAPID_SUBJECT=
# Protects /api/push/check (the cron that checks commutes). Required in production.
CRON_SECRET=
# Where push subscriptions are kept. Unset: a JSON file in .data/ (self-hosted `next start`).
# On serverless hosting (Vercel) use Postgres (Neon; the Vercel integration sets DATABASE_URL):
DATABASE_URL=
# ...or Upstash Redis / Vercel KV:
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Hackathon demo: "Buy" buys a demo ticket here (fake QR). Set to 0 to hand purchases to the real SBB app.
NEXT_PUBLIC_DEMO_TICKETS=1
